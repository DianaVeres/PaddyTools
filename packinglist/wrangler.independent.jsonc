{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paddy-packing-list",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paddy-packing-list-db",
      "database_id": "1c3284f2-56f0-4f44-81fb-99f9a128986e",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
