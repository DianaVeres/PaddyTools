# Base pública del módulo Incidencias, por ejemplo:
PUBLIC_BASE_URL=https://incidencias.tools.paddy.es

# Secreto SOLO de servidor a servidor entre Gestión Unificada e Incidencias.
PADDY_HANDOFF_SECRET=cambiar-por-un-secreto-largo

